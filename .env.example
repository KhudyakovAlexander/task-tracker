# Пароль PostgreSQL. На сервере замените на длинный уникальный пароль.
POSTGRES_PASSWORD="CHANGE_THIS_TO_A_LONG_UNIQUE_DATABASE_PASSWORD"

# Адрес PostgreSQL внутри Docker-сети.
# Пароль после tasktracker_app: должен совпадать с POSTGRES_PASSWORD.
DATABASE_URL="postgresql://tasktracker_app:CHANGE_THIS_TO_A_LONG_UNIQUE_DATABASE_PASSWORD@postgres:5432/tasktracker?schema=public"

# Секрет пользовательских сессий.
# На сервере замените на случайную строку длиной от 32 символов.
AUTH_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"

# Лимит суммарного размера файлов в одной заявке: 100 МБ.
MAX_REQUEST_ATTACHMENTS_BYTES="104857600"