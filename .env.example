# Адрес базы данных PostgreSQL.
# Настоящий пароль задаётся только на сервере в файле .env.
DATABASE_URL="postgresql://tasktracker_app:CHANGE_THIS_PASSWORD@postgres:5432/tasktracker?schema=public"

# Секрет для будущих пользовательских сессий.
# На сервере нужно заменить на длинную случайную строку.
AUTH_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"

# Максимальный суммарный размер всех файлов в одной заявке: 100 МБ.
MAX_REQUEST_ATTACHMENTS_BYTES="104857600"